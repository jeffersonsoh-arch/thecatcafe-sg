```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*

# Logs and temporary files
*.log
*.tmp

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
target/

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
*.py.class
.venv/
venv/
.env/

# Coverage reports
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```